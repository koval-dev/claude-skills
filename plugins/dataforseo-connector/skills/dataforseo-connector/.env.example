# DataForSEO connector — credential template.
# Copy to a gitignored .env in your project, fill in real values, and load it
# before running the connector:  set -a; . ./.env; set +a
#
# Never commit the filled-in .env. This .example file holds placeholders only.

DATAFORSEO_LOGIN=your-login-email
DATAFORSEO_PASSWORD=your-api-password-from-app.dataforseo.com/api-access

# Optional defaults (override per call with --location-name / --language-name):
# DATAFORSEO_LOCATION_NAME=United States
# DATAFORSEO_LANGUAGE_NAME=English
